<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivConfigAppIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvConfigAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Last Intercepted Notification"
            android:textStyle="bold"
            android:alpha="0.7" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRawTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title: N/A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRawText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Text: N/A" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Chip Customization"
            android:textStyle="bold"
            android:alpha="0.7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Text Source" />

        <RadioGroup
            android:id="@+id/rgTextSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSourceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original Title" />

            <RadioButton
                android:id="@+id/rbSourceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original Text" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Icon Source" />

        <RadioGroup
            android:id="@+id/rgIconSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbIconApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use App Launcher Icon" />

            <RadioButton
                android:id="@+id/rbIconNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Notification-Specific Icon" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Save Configuration" />

    </LinearLayout>
</ScrollView>
