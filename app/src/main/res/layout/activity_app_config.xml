<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConfigContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <android.view.View
        android:id="@+id/statusBarSpacerConfig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorPrimaryVariant" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarConfig"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="App Configuration"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:id="@+id/rootScrollConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pill Preview"
            android:textStyle="bold"
            android:alpha="0.7"
            android:layout_marginBottom="8dp" />

        <!-- Island Pill Preview -->
        <FrameLayout
            android:id="@+id/flPreviewPill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/black"
            android:layout_marginBottom="24dp">
            
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill_preview" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivPreviewIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:tint="@android:color/white" />

                <!-- Camera Cutout Mockup -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_camera_cutout" />

                <TextView
                    android:id="@+id/tvPreviewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Sample Text"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivConfigAppIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvConfigAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Last Intercepted Notification"
            android:textStyle="bold"
            android:alpha="0.7" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRawTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title: N/A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRawText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Text: N/A" />

                <TextView
                    android:id="@+id/tvRawSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SubText: N/A" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Chip Customization"
            android:textStyle="bold"
            android:alpha="0.7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Text Source" />

        <RadioGroup
            android:id="@+id/rgTextSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSourceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original Title" />

            <RadioButton
                android:id="@+id/rbSourceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original Text" />

            <RadioButton
                android:id="@+id/rbSourceSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original SubText" />

            <RadioButton
                android:id="@+id/rbSourceTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Original Title + Text" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Regex Filter (Optional)"
            android:textStyle="bold"
            android:alpha="0.7" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegexFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g. Price: (\\d+)"
            app:helperText="Extract groups or filter entire lines"
            app:placeholderText=".*"
            app:boxBackgroundMode="filled">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegexFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Icon Source" />

        <RadioGroup
            android:id="@+id/rgIconSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbIconApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use App Launcher Icon" />

            <RadioButton
                android:id="@+id/rbIconNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Notification-Specific Icon" />

            <RadioButton
                android:id="@+id/rbIconExtracted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use First Extracted Drawable" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Full Technical Dump"
            android:textStyle="bold"
            android:alpha="0.7" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/tvRawDump"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Waiting for next interception..."
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Notification Icons / Drawables"
            android:textStyle="bold"
            android:alpha="0.7" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/llNotificationDrawables"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
</LinearLayout>
