<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <android.view.View
        android:id="@+id/statusBarSpacerMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/colorPrimaryContainer" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMain"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Live Updates Playground"
        app:titleTextColor="@android:color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/rootScrollMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Updates Builder"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>
                
            <!-- Inputs -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Content Title">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ongoing Call" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Content Text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:42 • High Quality" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Status Chip Text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStatusChipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:42" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Icon Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Icon:"
                android:layout_marginTop="16dp"
                android:textStyle="bold"/>
                
            <RadioGroup
                android:id="@+id/rgIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbIconDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App" android:checked="true"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbIconTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timer"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbIconCall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbIconAlert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alert"/>
            </RadioGroup>

            <!-- Toggles -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ongoing Activity (SetOngoing=true)"
                android:checked="true"/>
                
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPromoted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promoted (Live Update Chip)"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbChronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Chronometer"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbShowProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Progress Bar (ProgressStyle)"
                android:checked="true"/>
                
            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Post Live Update"
                android:layout_marginTop="24dp"/>
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Last Posted"
                android:layout_marginTop="8dp"/>
                
             <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel All"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF0000"/>

            <!-- Active Notifications List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Notifications"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </ScrollView>

        <!-- HyperIsland Playground -->
        <ScrollView
            android:id="@+id/rootScrollHPlayground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HyperIsland Builder"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Content Title (Expanded)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="HyperIsland" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Content Text (Expanded)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Testing Island Rendering..." />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Left Pill Text (Small Side)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHLeftText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="40m" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Main Pill Text (Center Side)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHMainText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Turn Right" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Icon Selection (Reuse rgHIcon) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Icon:"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"/>
                
                <RadioGroup
                    android:id="@+id/rgHIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbHIconDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App" android:checked="true"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbHIconTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timer"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbHIconCall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/rbHIconAlert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alert"/>
                </RadioGroup>

                <!-- Raw JSON Injection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raw Focus JSON (Bypasses Builder):"
                    android:layout_marginTop="24dp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Paste complete JSON here...">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHyperRawJson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnHPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Post HyperIsland Notification"
                    android:layout_marginTop="24dp"/>
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHCancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel All"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF0000"/>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/rootScrollRecaster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Re-Caster"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cast as:"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <RadioGroup
                    android:id="@+id/rgCastAs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton 
                        android:id="@+id/rbCastAsLiveUpdates" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="Live Updates" 
                        android:checked="true"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton 
                        android:id="@+id/rbCastAsHyperIsland" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="HyperIsland"/>
                </RadioGroup>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swCastNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable Notification Casting"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Intercepts notifications from other apps and re-posts them as Dynamic Island chips."
                            android:textSize="12sp"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="12dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swUseAppIcon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Global: Use Launcher Icons"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Use the app's home screen icon instead of the system tray status icon by default."
                            android:textSize="12sp"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="12dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swShowProgressPercent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Global: Show percentage on chip"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="When a progress bar is active, show the percentage (e.g. 42%) on the status chip instead of the original text."
                            android:textSize="12sp"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="24dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swLimitChipText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AOSP only: Limit chip to 7 chars"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hard-limit the status bar text to 7 characters for better fit on AOSP ROMs or small cutouts."
                            android:textSize="12sp"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HyperIsland Notifications"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAppFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Apps to Cast"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvEnabledAppsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps enabled for casting (0)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llEnabledApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotificationAccess"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grant Notification Access"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
