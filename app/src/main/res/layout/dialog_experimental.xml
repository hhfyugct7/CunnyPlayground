<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification Casting"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Automatically turn notifications from other apps into Live Update chips."
        android:textSize="14sp"
        android:paddingTop="4dp" />

    <Switch
        android:id="@+id/swCastNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Enable Casting" />

    <Switch
        android:id="@+id/swUseAppIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use App Icon instead of Notification Icon" />

    <Button
        android:id="@+id/btnAppFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select Apps to Cast"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <Button
        android:id="@+id/btnNotificationAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Grant Notification Access"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Note: This is highly experimental and may not work with all apps."
        android:textSize="12sp"
        android:textStyle="italic"
        android:paddingTop="12dp"
        android:alpha="0.7" />

</LinearLayout>
