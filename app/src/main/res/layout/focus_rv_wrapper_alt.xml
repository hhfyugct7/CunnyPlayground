<?xml version="1.0" encoding="utf-8"?>
<!-- Byte-identical twin of focus_rv_wrapper.xml. Posting alternates between the two so the relayed
     custom template's layoutId changes every update, which forces OriginOS's CustomSuperXTemplate down
     the full apply() branch (mOldRemoteViews.getLayoutId() != remoteViews.getLayoutId()) instead of
     reapply() — the only way a nested addView() source RemoteViews actually re-inflates on update.
     KEEP IN SYNC with focus_rv_wrapper.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rv_wrapper_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp" />
