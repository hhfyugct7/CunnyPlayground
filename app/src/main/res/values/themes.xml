<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CunnyPlayground" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Optional base styles can go here, but colors will be handled dynamically -->
        <!-- Fallback colors if Dynamic Colors fails or isn't supported -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>
    </style>

    <style name="Theme.CunnyPlayground.NoActionBar" parent="Theme.CunnyPlayground">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>